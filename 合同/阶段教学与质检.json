{
  "version": "1",
  "flow": "教学引导 → 人提交材料 → Agent质检 → 打回/复核/通过 → Agent起草正式件 → 确定性门检 → 人批准 → 下一节点",
  "waiting": ["agent", "human", "done"],
  "activity": [
    "onboarding",
    "material_pending",
    "agent_review",
    "rework_required",
    "appeal_pending",
    "agent_draft",
    "human_gate",
    "done"
  ],
  "levels": [0, 1, 2],
  "mode_rule": {
    "novice": "any_level_is_0",
    "expert": "all_levels_are_2",
    "standard": "otherwise"
  },
  "quality_dims": [
    "completeness",
    "correctness",
    "consistency",
    "traceability",
    "executability"
  ],
  "pass_min_sum": 8,
  "zero_veto": true,
  "soft_confidence_floor": 0.8,
  "ui_bands": ["不合格", "基本合格", "合格"],
  "coaching_after_attempts": 3,
  "appeal": {
    "hard": "forbidden",
    "soft": ["UPHOLD", "OVERRIDE_SOFT"]
  },
  "agent_may": ["teach", "review", "rework", "draft"],
  "agent_may_not": ["APPROVE", "override_hard"],
  "human_only": ["APPROVE", "UPHOLD", "OVERRIDE_SOFT"],
  "teach_focus": {
    "01": "产品线与禁售",
    "02": "主终点和监测组",
    "07": "范围、人时和报价",
    "08": "对象与口径边界",
    "03": "冻结、噪声、App/API",
    "04": "WBS、依赖和预算",
    "05": "诊断/冲刺执行边界",
    "06": "验收一致性",
    "09": "资产脱敏和正式关项"
  },
  "hard_rules": [
    "required_materials",
    "field_legal",
    "stage_order",
    "banned",
    "cross_stage",
    "material_path",
    "evidence"
  ],
  "notes": "讲解文案和五项质量怎么打分由 Agent 当场做。本文件只锁流程、门槛和权限。"
}
